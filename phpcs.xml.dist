<?xml version="1.0"?>
<ruleset name="PortalADAPT">
    <description>
        PHP_CodeSniffer rules for the Portal ADAPT theme: PHP 8.1-8.3
        compatibility, plus a targeted set of WordPress security/i18n
        sniffs. Mirrors .stylelintrc.json's philosophy on an inherited
        codebase - flag real bugs (unescaped output, missing nonce checks,
        unprepared SQL, deprecated APIs), not a full retroactive
        formatting/whitespace rewrite (indentation, brace placement, Yoda
        conditions, etc. are intentionally not enforced here).
    </description>

    <file>.</file>

    <!-- Bundled third-party plugin code and build input/output - not this
         theme's own PHP. -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/source/*</exclude-pattern>
    <exclude-pattern>*/memberpress/*</exclude-pattern>
    <exclude-pattern>*/memberpress-corporate/*</exclude-pattern>
    <exclude-pattern>*/download-monitor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <!-- PHP version compatibility - flags deprecated/removed language
         features and functions so the theme keeps working as the site's
         PHP version moves forward. style.css declares
         "Requires PHP: 8.3"; 8.1 is included as the practical floor so
         issues surface a version early rather than right at the edge. -->
    <config name="testVersion" value="8.1-8.3"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Targeted WordPress sniffs. -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedParameterValues"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>

    <!-- Flags raw date()/gmdate()/etc. in favor of wp_date()/current_time() -
         a real, live issue in this codebase (functions.php batch/cron dedup
         keys, several date-cutoff checks in templates use date() directly),
         but left as a flag rather than an auto-fix: some of those call
         sites may deliberately want UTC-consistent date buckets regardless
         of the site's configured timezone, which only whoever wrote that
         cron logic can confirm. -->
    <rule ref="WordPress.DateTime.RestrictedFunctions"/>

    <!-- Text domain is 'portal' (see style.css "Text Domain" header and
         includes/_setup.php's load_theme_textdomain() call). -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="portal"/>
            </property>
        </properties>
    </rule>
</ruleset>
