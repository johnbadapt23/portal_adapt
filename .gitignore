# Dependencies
node_modules/

# Old Bower vendor libraries - superseded by npm packages in node_modules,
# no longer referenced by source/gulp/paths.js. Kept on disk but not tracked.
source/components/

# NOTE: assets/ is intentionally tracked, not ignored. Most of it (images,
# webfonts, admin.css, etc.) is static production content with no source/
# equivalent -- only assets/css/main.min.css and assets/js/main.min.js are
# actually regenerated by `npx gulp _build`, and CI overwrites those fresh
# before every deploy regardless of what's committed.

# OS junk
.DS_Store
._*
Thumbs.db

# Logs
npm-debug.log*
*.log

# Env / local config
.env
.env.local

# Editor
.vscode/
.idea/
